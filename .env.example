# Copy to .env and edit. Every value is optional.
DATA_DIR=data
MAX_UPLOAD_MB=50
SESSION_HOURS=8
# password given to the seeded demo accounts (admin / investigator / viewer) on FIRST run
DEMO_PASSWORD=Demo@1234
# set to 1 only when serving over HTTPS
COOKIE_SECURE=0
# cosine-similarity reference threshold for SFace matching (OpenCV tutorial value; not validated on your data)
MATCH_COSINE_THRESHOLD=0.363
REFERENCE_RETENTION_DAYS=30
# Optional fixed keys. If unset, keys are generated into DATA_DIR on first run. Losing vault.key = losing your files.
# DATA_KEY=
# SESSION_SECRET=
